// ===== Silver — Tiền đã về TikTok (đối soát settlement, Phase 2) =====
// Nguồn: Bronze RawTiktokShop{Statement,Transaction,Payment}. CHỈ dòng tiền ĐỐI CHIẾU
// (tiền TikTok đã thanh toán) — ĐỘC LẬP P&L/doanh thu (doanh thu CHỈ từ Pancake, bất biến #2).
// Money = Int VND (payload là STRING → đọc lossless). Ngày = instant từ epoch giây
// (`new Date(epoch*1000)`; container TZ=Asia/Ho_Chi_Minh nên biên tháng theo giờ VN).

model TiktokSettlement {
  id                 String    @id @default(cuid())
  statementId        String    @unique // = externalId statement (id sao kê)
  shopId             String
  statementTime      DateTime
  paymentTime        DateTime?
  paymentStatus      String
  paymentId          String? // link TiktokPayment (sao kê gộp vào lệnh rút nào)
  settlementAmount   Int // NET đã về (sau phí/hoàn/ads)
  revenueAmount      Int
  feeAmount          Int
  adjustmentAmount   Int
  netSalesAmount     Int
  shippingCostAmount Int
  currency           String    @default("VND")
  raw                Json?
  syncedAt           DateTime  @default(now())

  @@index([statementTime])
}

model TiktokAdsSettlement {
  id               String   @id @default(cuid())
  transactionId    String   @unique // = externalId txn (type=GMV_PAYMENT_FOR_TIKTOK_ADS)
  shopId           String
  adjustmentId     String?
  orderCreateTime  DateTime
  settlementAmount Int // ÂM — TikTok trừ ads vào số dư
  raw              Json?
  syncedAt         DateTime @default(now())

  @@index([orderCreateTime])
}

model TiktokPayment {
  id              String    @id @default(cuid())
  paymentId       String    @unique // = externalId payment
  shopId          String
  status          String // PAID | FAILED | ...
  paidTime        DateTime?
  settlementValue Int // tiền vào bank (settlement_amount.value)
  amountValue     Int
  reserveValue    Int       @default(0)
  bankAccount     String?
  raw             Json?
  syncedAt        DateTime  @default(now())

  @@index([paidTime])
}

// ===== Bronze + Silver — Tiền đã về Shopee (import file ví THỦ CÔNG, Phase 3) =====
// Shopee KHÔNG có API → chủ shop tải TAY file ví "Transaction Report" (my_balance_transaction)
// mỗi kỳ → upload UI → land Bronze RawShopeeWalletTxn → transform Silver ShopeeSettlement.
// CHỈ dòng tiền "đã về" (net + rút bank) — ĐỘC LẬP P&L/doanh thu (doanh thu CHỈ từ Pancake,
// bất biến #2). Phí sàn Shopee đã có ở P&L qua Pancake `fee_marketplace` — TUYỆT ĐỐI KHÔNG
// lấy số ví sửa P&L (đếm 2 lần). Money = Int VND; txnTime = instant giờ VN (có giây).

model RawShopeeWalletTxn {
  id          String   @id @default(cuid())
  shopId      String
  externalId  String
  payloadHash String
  payload     Json
  fetchedAt   DateTime @default(now())
  syncLogId   String?

  @@unique([shopId, externalId, payloadHash])
  @@index([shopId, externalId, fetchedAt])
  @@index([fetchedAt])
}

// Grain = 1 dòng ledger ví. `externalId` = khoá tổng hợp `txnTime|type|orderCode|amount` (bất biến
// qua re-export — KHÔNG dùng runningBalance vì số dư dịch khi có điều chỉnh back-date → đếm 2 lần).
// `amount` CÓ DẤU (ép theo cột "Dòng tiền": Tiền ra→âm, Tiền vào→dương). `runningBalance` lưu để
// hiển thị, KHÔNG vào khoá. net "đã về" = Σ amount type∈{REVENUE,ADJUSTMENT}; rút bank = |Σ| WITHDRAWAL.
model ShopeeSettlement {
  id             String   @id @default(cuid())
  externalId     String   @unique
  shopId         String
  txnTime        DateTime
  type           String // REVENUE | ADJUSTMENT | WITHDRAWAL | OTHER
  orderCode      String?
  amount         Int // CÓ DẤU (ép theo cột "Dòng tiền")
  status         String
  runningBalance Int // lưu display — KHÔNG vào khoá externalId
  raw            Json?
  syncedAt       DateTime @default(now())

  @@index([txnTime])
}

/// Báo cáo CHI TIÊU quảng cáo TikTok Business (business-api.tiktok.com) — API KHÁC HẲN TikTok Shop.
/// `shopId` ở đây = **advertiser_id** (tài khoản quảng cáo), KHÔNG phải shop.
/// `externalId` = `<campaign_id>:<ngày>` — báo cáo ads không có `id`, khoá tự nhiên là (chiến dịch, ngày).
/// CHỈ chi tiêu: TUYỆT ĐỐI không lấy GMV/doanh thu từ nguồn này (doanh thu chỉ từ Pancake).
model RawTiktokBusinessReport {
  id          String   @id @default(cuid())
  shopId      String
  externalId  String
  payloadHash String
  payload     Json
  fetchedAt   DateTime @default(now())
  syncLogId   String?

  @@unique([shopId, externalId, payloadHash])
  @@index([shopId, externalId, fetchedAt])
  @@index([fetchedAt])
}

/// HOÁ ĐƠN quảng cáo TikTok (Business Center) — số TIỀN THẬT TikTok thu, GỒM VAT 10%.
/// `cost` trong report ads là số CHƯA THUẾ ⇒ P&L ghi theo report là thiếu 10%.
/// Kiểm chứng 2026-07-14: report 130.000 → hoá đơn 143.000 → statement TikTok Shop trừ đúng −143.000.
/// `shopId` = bc_id (Business Center). `externalId` = transaction_id.
model RawTiktokBusinessInvoice {
  id          String   @id @default(cuid())
  shopId      String
  externalId  String
  payloadHash String
  payload     Json
  fetchedAt   DateTime @default(now())
  syncLogId   String?

  @@unique([shopId, externalId, payloadHash])
  @@index([shopId, externalId, fetchedAt])
  @@index([fetchedAt])
}

/// Báo cáo CHI TIÊU quảng cáo Meta (Facebook Marketing API). `shopId` = ad account id (`act_...`).
/// `externalId` = `<campaign_id>:<ngày>` — dòng insights không có `id`.
/// ⚠️ `spend` trong payload là số CHƯA THUẾ. Meta KHÔNG có API hoá đơn cho tài khoản trả thẻ ⇒ VAT khai tay, ĐÃ CHỐT 10% (app nhân khi ghi Expense — payload Bronze giữ nguyên số chưa thuế).
/// CHỈ chi tiêu: TUYỆT ĐỐI không lấy conversion value làm doanh thu.
model RawMetaAdsReport {
  id          String   @id @default(cuid())
  shopId      String
  externalId  String
  payloadHash String
  payload     Json
  fetchedAt   DateTime @default(now())
  syncLogId   String?

  @@unique([shopId, externalId, payloadHash])
  @@index([shopId, externalId, fetchedAt])
  @@index([fetchedAt])
}

/// Hộp thư THÔ hứng webhook Pancake POS — CHỈ LƯU, KHÔNG xử lý, KHÔNG dựng Silver.
/// Cửa vào không cần hiểu payload: loại sự kiện nào cũng nhận (`orders`, `products`,
/// `variations_warehouses`, và loại Pancake thêm sau) nên không bao giờ mất dữ liệu vì
/// app chưa biết shape. Nơi transform đọc để dựng Silver vẫn LÀ các bảng Bronze cũ —
/// bảng này KHÔNG được làm nguồn thứ 2 cho Silver/P&L.
///
/// `payload` là TEXT **nguyên xi** chứ không phải jsonb: giữ đúng từng byte Pancake gửi
/// (id int64 như `585140898791786238` an toàn tuyệt đối, không bị chuẩn hoá khoá/khoảng trắng).
/// Cần truy vấn thì cast tại chỗ: `payload::jsonb->>'type'`. Chiều TEXT → jsonb luôn dựng được,
/// chiều ngược lại thì không.
///
/// KHÔNG đặt job dọn theo hạn: kho mẫu webhook của hệ cũ đã mất sạch vì đúng một cron
/// xoá > 30 ngày. Khối lượng ~12 sự kiện/ngày (~44MB/năm) — giữ vĩnh viễn.
model RawPancakeWebhookEvent {
  id            String   @id @default(cuid())
  /// Shop Pancake suy từ endpoint nhận (`SHOP_KHO` | `SHOP_SHOPEE` | `SHOP_TIKTOK`).
  shopId        String
  payload       String
  /// md5(payload) — chỉ để nạp bù chạy lại không nhân bản dòng, KHÔNG phải để lọc dữ liệu.
  payloadHash   String
  receivedAt    DateTime @default(now())
  /// Đường vào: `webhook` (n8n bắn thẳng) | `file` (nạp bù từ file mẫu pha 1) | `db-cu`
  /// (nạp bù từ bảng `webhook_raw_events` của hệ trước 2026-06).
  source        String   @default("webhook")
  /// KẾT CỤC xử lý pha 2 (payload gốc không bao giờ sửa): `don-hang` | `don-hang-cu-hon` |
  /// `don-hang-can-xem` | `ton-kho-bo-qua` | `san-pham-bo-qua` | `bronze-only` |
  /// `khong-nhan-dien` | `loi`. Nguồn giá trị: `KetCucXuLy` ở `src/lib/ingest/webhook-processor.ts`.
  /// NULL = dòng trước pha 2 / nạp bù (không replay — snapshot cũ đè bản API mới là hỏng Silver).
  processedAs   String?
  /// Chi tiết cho ca cần người xem (sự kiện lạ, lỗi xử lý) — hiển thị ở /cai-dat để bắt lỗi vào fix.
  processedNote String?

  /// Khoá idempotent cho nạp bù: chạy lại script trên cùng file/bản ghi không đẻ dòng mới.
  /// Sự kiện LIVE luôn có `receivedAt` mới nên 2 lần Pancake bắn trùng vẫn giữ đủ cả hai.
  @@unique([shopId, receivedAt, payloadHash])
  @@index([shopId, receivedAt])
  @@index([receivedAt])
}
