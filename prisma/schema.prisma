// ===== Bronze raw TikTok Shop Open API =====
// CHỈ dùng cho PHÍ / ĐỐI SOÁT tiền thực nhận / hoa hồng affiliate — TUYỆT ĐỐI KHÔNG
// lấy làm doanh thu (doanh thu chỉ từ Pancake, nếu không sẽ đếm 2 lần cùng một giao dịch).
// `shopId` ở các bảng này là shop id của TikTok Shop (7494544063361551019), KHÁC id
// shop TikTok bên Pancake (100975192). Land-only: Silver cho phí/đối soát chưa định nghĩa.

model RawTiktokShopStatement {
  id          String   @id @default(cuid())
  shopId      String
  externalId  String
  payloadHash String
  payload     Json
