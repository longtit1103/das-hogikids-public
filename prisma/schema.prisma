generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String // crypto.scrypt
  shopName     String   @default("HogiKids")
  shopPhone    String?
  shopLogoPath String?
  createdAt    DateTime @default(now())
}

model Channel {
  id             String    @id // "shopee" | "tiktok" | "facebook" | "website"
  name           String
  color          String
  isActive       Boolean   @default(true)
  platformFeePct Float     @default(0) // % phí sàn ước tính
  paymentFeePct  Float     @default(0) // % phí thanh toán — cộng chung khi tính platformFeeEst
  sortOrder      Int
  orders         Order[]
  expenses       Expense[]
}

enum ProductStatus {
  ACTIVE
  HIDDEN
}

model Product {
  id           String        @id @default(cuid())
  pancakeId    String        @unique // id sản phẩm bên Pancake (idempotency key)
  name         String
  code         String? // mã SP bên Pancake nếu có
  categoryName String?
  imageUrl     String? // URL ảnh Pancake (không tải về)
  status       ProductStatus @default(ACTIVE)
  variants     Variant[]
  syncedAt     DateTime
}

model Variant {
  id                String      @id @default(cuid())
  pancakeId         String      @unique
  productId         String
  product           Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String // không unique tuyệt đối (Pancake có thể trùng) → tra theo pancakeId
  label             String // tên biến thể Pancake, vd "3-4T / Đỏ"
  sellPrice         Int         @default(0) // giá bán sync
  stock             Int         @default(0) // tồn sync realtime
  costPrice         Int         @default(0) // APP-OWNED: giá vốn nhập trong app — ingest KHÔNG ghi đè
  lowStockThreshold Int? // APP-OWNED; null → Setting defaultLowStockThreshold
  items             OrderItem[]
  syncedAt          DateTime
  /// Mốc `inserted_at` của sự kiện webhook tồn kho gần nhất đã ghi vào `stock`.
  /// null = tồn đang do API khẳng định (mọi lượt vá từ Bronze đều xoá cột này về null).
  /// Dùng làm mốc so thứ tự: sự kiện chỉ được ghi khi mới hơn CẢ `syncedAt` lẫn cột này.
  stockUpdatedAt    DateTime?

  @@index([sku])
}

// Map từ trạng thái Pancake (bảng map cụ thể ở phase 2). Hợp lệ cho P&L = không RETURNED/CANCELLED.
enum OrderStatus {
  PENDING
  SHIPPING
  COMPLETED
  RETURNED
  CANCELLED
}

model Order {
  id                   String      @id @default(cuid())
  pancakeId            String      @unique
  code                 String // mã đơn Pancake/sàn hiển thị
  channelId            String
  channel              Channel     @relation(fields: [channelId], references: [id])
  status               OrderStatus
  orderedAt            DateTime
  statusChangedAt      DateTime? // thời điểm đơn VÀO trạng thái hiện tại (Pancake status_history; fallback updated_at) — dữ liệu Pancake, KHÔNG phải @updatedAt app
  customerName         String?
  itemsTotal           Int         @default(0) // tổng tiền hàng (sau giảm giá dòng) — NGUỒN Doanh thu P&L
  shipFeeCustomer      Int         @default(0) // tham khảo, KHÔNG vào doanh thu
  discount             Int         @default(0) // voucher/giảm giá shop chịu — trừ vào Doanh thu thuần
  platformFeeEst       Int         @default(0) // Shopee/TikTok: = fee_marketplace THẬT của Pancake (bất biến #1, KHÔNG ước tính %). Kênh chưa có phí thật (FB/website): fallback round(itemsTotal × (platformFeePct+paymentFeePct)/100). Xem usesRealPlatformFee/pancake-mapping.ts.
  returnedFee          Int         @default(0) // = advanced_platform_fee.returned_fee — phí sàn THỰC sàn giữ trên đơn hoàn/hủy (0 khi chưa đối soát). KHÁC platformFeeEst (tạm). Ghi đè khi re-sync.
  items                OrderItem[]
  syncedAt             DateTime
  raw                  Json? // payload gốc để debug mapping
  /// MỐC NGUỒN: `fetchedAt` của dòng kho thô đã dựng nên bản Silver này — SỐ PHIÊN BẢN, không phải
  /// mốc đồng bộ (`syncedAt` là "app ghi lúc nào", cái này là "dữ liệu chụp lúc nào"). Lượt ghi chỉ
  /// được đè khi mốc của nó MỚI HƠN HOẶC BẰNG mốc đang lưu, nhờ vậy hai lượt dựng Silver chạy song
  /// song không ghi ngược thứ tự (bước dựng Silver cố ý nằm NGOÀI khoá land để webhook khỏi xếp
  /// hàng). `null` = bản ghi có trước khi thêm cột này ⇒ lượt ghi nào cũng được đè (tự lành dần).
  rawFetchedAt         DateTime?
  /// Đơn được BÙ từ bản sao trong shop kho vì Pancake không còn đơn gốc ở shop bán
  /// (`scripts/bu-don-shopee-tu-don-kho.ts`). Vào P&L y hệt đơn thường — cờ này CHỈ để các đường
  /// bảo vệ tiền nhận ra: lượt dựng lại KHÔNG tái tạo được chúng (luật mirror loại), và phép đếm
  /// "đơn kẹt" phải trừ chúng ra, nếu không app sẽ khuyên chủ shop xoá đúng phần doanh thu thật.
  backfilledFromMirror Boolean     @default(false)

  @@index([orderedAt])
  @@index([channelId, orderedAt])
  @@index([status])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId    String? // null nếu SKU không khớp variant nào (mapping ghi cảnh báo)
  variant      Variant? @relation(fields: [variantId], references: [id])
  sku          String
  productName  String
  quantity     Int
  unitPrice    Int // đơn giá 1 sp — GỘP (trước giảm giá; discount_each_product Pancake là giảm giá MỖI ĐƠN VỊ)
  lineDiscount Int      @default(0) // giảm giá dòng SHOP CHỊU = quantity × discount_each_product − phần sàn tài trợ phân bổ về dòng (xem src/lib/ingest/voucher-san-tai-tro.ts) — để Σ doanh thu dòng khớp Order.itemsTotal

  // COGS KHÔNG snapshot: tính động = quantity × variant.costPrice (giá vốn hiện hành — quyết định grill)
  @@index([orderId]) // join order→items khi tính COGS/P&L từng đơn
  @@index([variantId]) // rollup theo biến thể (top SP, tồn kho, giá vốn thiếu)
}

model ExpenseCategory {
  id       String    @id
  // Trùng tên làm dropdown "Thêm chi phí" hiện hai dòng giống nhau, chủ shop chọn nhầm sang dòng
  // rỗng. Hàm kiểm trong app là check-then-create nên hai submit đồng thời lọt cả hai — ràng buộc
  // này là cổng cuối. Case-SENSITIVE (Postgres): chỉ đóng khe trùng y hệt chữ hoa/thường; khe khác
  // hoa/thường vẫn do phép kiểm case-insensitive trong app lo.
  name     String    @unique
  isSystem Boolean   @default(false)
  isHidden Boolean   @default(false)
  expenses Expense[]
}

enum ExpenseSource {
  MANUAL
  RECURRING
  IMPORT
  ADS_API
}

model Expense {
  id          String          @id @default(cuid())
  date        DateTime
  categoryId  String
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  adsSource   String? // META | TIKTOK_ADS khi categoryId="ads"
  description String
  channelId   String?
  channel     Channel?        @relation(fields: [channelId], references: [id])
  amount      Int
  source      ExpenseSource   @default(MANUAL)
  refId       String?         @unique // idempotency cho ADS_API: "META:2026-07-04:{campaignId}" (source viết HOA) — ingest lại không trùng
  recurringId String?
  createdAt   DateTime        @default(now())

  @@index([date])
  @@index([categoryId, date])
}

model RecurringExpense {
  id          String  @id @default(cuid())
  categoryId  String
  amount      Int
  dayOfMonth  Int
  description String
  channelId   String?
  active      Boolean @default(true)
}

enum SyncKind {
  PANCAKE
  META_ADS
  TIKTOK_ADS
  TIKTOK_SHOP // phí/đối soát TikTok Shop Open API — luồng RIÊNG, KHÔNG trộn vào PANCAKE
  BACKUP
}

enum SyncStatus {
  RUNNING
  OK
  ERROR
}

model SyncLog {
  id         String     @id @default(cuid())
  kind       SyncKind
  status     SyncStatus @default(RUNNING)
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  stats      Json? // {ordersUpserted, productsUpserted, variantsUpserted, adRows, warnings[]}
  error      String?

  @@index([kind, startedAt])
}

model Setting {
  key   String @id
  value String

  /// Sửa lần gần nhất. Bảng này vừa là kho khoá cho workflow n8n vừa là chỗ người sửa tay, nên cột
  /// này còn được một trigger Postgres giữ đúng — sửa thẳng bằng SQL/Studio/NocoDB (không qua Prisma)
  /// vẫn cập nhật. Lưu UTC như mọi cột thời gian khác của Prisma.
  updatedAt DateTime @default(now()) @updatedAt
}

// keys — cấu hình app: defaultLowStockThreshold="5", slowSellerMaxOrders="2", lastBackupAt,
//   bronzeBacklogPending
// keys — token OAuth xoay vòng (ghi qua route kho token, KHÔNG sửa tay):
//   tiktokShop{AccessToken,RefreshToken,AccessTokenExpireAt,TokenSavedAt}, metaAds{AccessToken,
//   TokenExpireAt,DataAccessExpireAt,TokenSavedAt}
// keys — khoá tĩnh cho workflow n8n (đọc bằng node Postgres, role n8n_config_ro chỉ SELECT bảng này):
//   n8nAppUrl, n8nIngestSecret, tiktokShop{AppKey,AppSecret,Cipher,ShopId},
//   tiktokShopManualDays (tuỳ chọn — cửa sổ ngày cho lượt chạy tay của tiktokshop-nightly)

// ===== Bronze raw layer (medallion architecture) =====
// Land raw Pancake responses nguyên bản: PAYLOAD bất biến (chỉ INSERT, không bao giờ sửa).
// Ngoại lệ DUY NHẤT là các cột metadata ghi KẾT CỤC xử lý của `RawPancakeOrder` (xem dưới) —
// chúng nằm ngoài payload, đúng khuôn `processedAs`/`processedNote` của hộp thư webhook.
// Transform đọc từ các bảng này ra Silver (Order/Product/Variant...) — xem src/lib/bronze/.
// `externalId` LƯU STRING vì id gốc Pancake có thể là int64 (JS không lọt qua
// an toàn — không JSON.parse payload trong app, land bằng TEXT → Postgres ::jsonb).

model RawPancakeOrder {
  id          String   @id @default(cuid())
  shopId      String
  externalId  String // `id` gốc — LƯU STRING (int64 không lọt qua JS)
  payloadHash String // md5 của jsonb đã chuẩn hoá (Postgres tính)
  payload     Json
  fetchedAt   DateTime @default(now())
  syncLogId   String?

  /// KẾT CỤC dựng Silver của CHÍNH dòng này (payload không bao giờ bị sửa):
  ///   `APPLIED`         — đã ghi vào Silver.
  ///   `EXCLUDED_MIRROR` — transform CỐ Ý không ghi (đơn mirror kho, bất biến doanh thu #2).
  ///                       KHÔNG có nghĩa "không tồn tại đơn Silver nào": script bù đơn Shopee
  ///                       dựng đơn thật TỪ chính các dòng mirror này (46/522 dòng, 7,89tr).
  ///   `SUPERSEDED`      — đã có phiên bản mới hơn thắng (thua CAS `rawFetchedAt`, hoặc không
  ///                       phải bản mới nhất của khoá (shopId, externalId)).
  ///   `FAILED_SHAPE`    — payload hiện KHÔNG map được (shape sai, ngày giờ không hợp lệ…). Payload
  ///                       bất biến ⇒ lỗi TẤT ĐỊNH ⇒ dừng retry tự động, nhưng vẫn hiện "cần xem".
  ///                       Sửa mapping xong thì lượt dựng lại TAY được phép thử lại.
  ///   `FAILED_RETRY_LIMIT` — đã thử lại đủ số lượt mà vẫn hỏng. Khác `FAILED_SHAPE` ở chỗ lỗi
  ///                       KHÔNG nhìn ra được từ payload (lỗi ghi lặp lại), nhưng để nó thử mãi thì
  ///                       lượt đêm hỏng vĩnh viễn. Lượt dựng lại TAY vẫn được thử lại.
  ///   `DISCARDED`       — chủ shop đã bấm "Xóa dữ liệu giao dịch" khi dòng còn dở. Sổ đã được xoá
  ///                       CÓ CHỦ ĐÍCH nên dòng này KHÔNG được dựng lại tự động; chỉ lượt dựng lại
  ///                       TAY (có quyền riêng) mới ghi đè được.
  ///   `LEGACY`          — dòng có trước migration 20260811110000, chờ lượt đối soát phân loại.
  ///   NULL              — chưa hoàn tất, HOẶC gặp lỗi chưa phân loại được (ghi DB / mạng — tự
  ///                       lành được nên PHẢI còn retry). Đây là trạng thái MẶC ĐỊNH của dòng
  ///                       mới: chết giữa chừng thì dòng ở lại đây và lượt đối soát đêm nhặt lên.
  /// ⚠️ KHÔNG phải oracle "đơn có trong Silver hay không" — chỉ là dấu vết một lần cố xử lý. Sau
  /// nút "Xóa dữ liệu giao dịch", dòng vẫn APPLIED trong khi Silver rỗng; đường dựng lại đúng là
  /// nút "Dựng lại từ kho thô", KHÔNG phải lượt đối soát (nếu không, nút Xoá thành vô tác dụng).
  silverOutcome       String?
  /// Lúc đóng dấu kết cục. NULL khi chưa đóng.
  silverProcessedAt   DateTime?
  /// Lý do cho ca cần người xem (map hỏng, lỗi ghi) — CHỈ là thông báo lỗi GẦN NHẤT cho người
  /// đọc. TUYỆT ĐỐI không nhét cấu trúc/bộ đếm vào đây: máy đọc thì dùng 2 cột dưới.
  silverNote          String?
  /// Số lượt ĐỐI SOÁT TỰ ĐỘNG đã thử dòng này và nhận lỗi GẮN VỚI CHÍNH NÓ. Lỗi hạ tầng/cả lô
  /// (không đối soát được đáng tin cậy) KHÔNG được tính — nếu không, một nhịp DB chập sẽ đẩy cả
  /// nghìn dòng tới ngưỡng dừng-thử-lại cùng lúc.
  silverAttempts      Int       @default(0)
  /// Mốc lượt thử gần nhất — dùng để ép các lượt thử CÁCH XA nhau (một sự cố kéo dài không được
  /// tính là nhiều lượt thử độc lập).
  silverLastAttemptAt DateTime?

  @@unique([shopId, externalId, payloadHash])
  @@index([shopId, externalId, fetchedAt])
  @@index([fetchedAt])
}

